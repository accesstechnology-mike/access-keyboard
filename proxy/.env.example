# Copy to .env.local and paste the OpenAI key there.
# .env.local is gitignored. This file is not.
# FIX_PROXY_SECRET must also be set on Vercel (Production and Preview).

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none
OPENAI_BASE_URL=https://api.openai.com/v1
FIX_PROXY_SECRET=
PORT=8787

# --- Fix limits (defaults confirmed 19 Oct 2026). All optional. ---
# Usage counters: Upstash Redis REST, or the same values from Vercel KV.
# Without one, Fix works but limits are NOT enforced (unless FIX_REQUIRE_USAGE_STORE=true).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
FREE_FIXES_PER_MONTH=30
PRO_FIXES_PER_DAY=100
FIX_RATE_PER_MINUTE=10
FIX_IP_RATE_PER_MINUTE=30
FIX_MAX_CHARS=8000
FIX_MAX_OUTPUT_TOKENS=2048
# Apple signed-data checks (App Store Server Library).
APPLE_BUNDLE_ID=app.access.keyboard.6M3Z27M69P
APPLE_APP_APPLE_ID=6803257519
# PRO_SUBSCRIPTION_PRODUCT_IDS=app.access.keyboard.6M3Z27M69P.pro.monthly,app.access.keyboard.6M3Z27M69P.pro.yearly
# PRO_LIFETIME_PRODUCT_IDS=app.access.keyboard.6M3Z27M69P.pro.lifetime
FIX_ALLOW_SANDBOX=true
FIX_APPLE_ONLINE_CHECKS=true
# Rollout switches.
FIX_ALLOW_LEGACY_SECRET=true
FIX_REQUIRE_USAGE_STORE=false
